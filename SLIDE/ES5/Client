#include <iostream>
#include <string>
#include <cstring>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <stdlib.h>
#include <thread>
#include <atomic>

using namespace std;

#define PORT 8080
#define BUFFER 1024

atomic<bool> chatting = false;

int peer_port;
struct sockaddr_in peer_address;

void sendMsg(int socket, string msg){

        if ((send(socket, msg.c_str(), msg.size(), 0)) < 0){
            perror("Errore nell'invio dei dati\n");
            return;
        }
}

void recvMsg(int socket){

    while (true){

        char buffer[BUFFER];
        int n;

        n = recv(socket, buffer, BUFFER, 0);
        if (n < 0){
            perror("Errore nella ricezione dei dati\n");
            return;
        }
        buffer[n] = '\0';

        cout << buffer << endl;

        string receive = string(buffer);
        if (receive.find("Info") != string::npos) {
            int p1 = receive.find(": ");
            int p2 = receive.find("|");

            string ip = receive.substr(p1 + 2, p2 - p1 - 2);
            cout << "ip peer: " << ip << "|" << endl;

            inet_pton(AF_INET, ip.c_str(), &peer_address.sin_addr);

            peer_port = stoi(receive.substr(p2 + 2));
            cout << "port peer: " << peer_port << "|" << endl;

            chatting = true;
        }

    }

}

void recvMsgUDP(int socket){
    sockaddr_in address;
    socklen_t len = sizeof(address);
    while (true){

        char buffer[BUFFER];
        int n;

        n = recvfrom(socket, buffer, BUFFER, 0, (struct sockaddr*)&address, &len);
        if (n < 0){
            perror("Errore nella ricezione dei dati\n");
            return;
        }
        buffer[n] = '\0';

        cout << buffer << endl;

    }

}

void sendUDP(string msg, int socket, struct sockaddr_in peer_address, int peer_port) {

    peer_address.sin_family = AF_INET;
    peer_address.sin_port = htons(peer_port);

    if (sendto(socket, msg.c_str(), msg.size(), 0, (struct sockaddr*)&peer_address, sizeof(peer_address)) < 0) {
        perror("Errore nell'invio dei dati udp\n");
        return;
    }

}

int main(){

    int sockfd;
    struct sockaddr_in server_addr;
    socklen_t len = sizeof(server_addr);

    sockfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockfd < 0){
        perror("Errore nella socket\n");
        return -1;
    }

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    inet_pton(AF_INET, "127.0.0.1", &server_addr.sin_addr);

    if((connect(sockfd, (struct sockaddr*)&server_addr, len)) < 0){
        perror("Errore nella connessione con il server\n");
        return -1;
    }
    cout << "Client connesso al server...\n";

    int p2p_port;
    cout << "Inserisci porta P2P comunicata al server: ";
    cin >> p2p_port;
    cout << endl;

    int udp_socket = socket(AF_INET, SOCK_DGRAM, 0);
    if (udp_socket < 0) {
        perror("Errore nella socket udp\n");
        return -1;
    }

    struct sockaddr_in address;
    address.sin_family = AF_INET;
    address.sin_port = htons(p2p_port);
    inet_pton(AF_INET, "127.0.0.1", &address.sin_addr);

    if (bind(udp_socket, (struct sockaddr*)&address, sizeof(address)) < 0) {
        perror("Errore nel bind udp\n");
        return -1;
    }

    thread ricezione1(recvMsg, sockfd);
    ricezione1.detach();

    thread ricezione2(recvMsgUDP, udp_socket);
    ricezione2.detach();

    while (true) {
        string msg;
        getline(cin, msg);
        if (chatting) {
            sendUDP(msg, udp_socket, peer_address, peer_port);
        } else {
            sendMsg(sockfd, msg);
        }
    }

}