#include <iostream>
#include <stdlib.h>
#include <unistd.h>
#include <thread>
#include <cstring>
#include <string>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <atomic>

using namespace std;

#define BUFFER 1024

atomic<bool> allarm = false;

void rcvMsg(int socket) {
    char buffer[BUFFER];
    while (true) {  
        int n = recv(socket, buffer, BUFFER - 1, 0);
        if (n <= 0) {
            perror("Errore nella ricezione dei dati\n");
            continue;
        }
        buffer[n] = '\0';

        string msg = string(buffer);

        if (msg == "STOP ALARM") {
            cout << "---ALLARME DISATTIVATO---" << endl;
            allarm = false;
        } 
    }
}

void protocol(int socket, string id) {
    string msg;
    while (true) {
        while (!allarm){
            int temp = rand() % 45;
            int hum = rand() % 100;
            string air = rand() % 2 ? "GOOD" : "POOR";

            msg = "Sensore " + id + ": " + to_string(temp) + " | " + to_string(hum) + " | " + air;

            cout << msg << endl;

            if (send(socket, msg.c_str(), msg.size(), 0) < 0) {
                perror("Errore nell'invio dei dati\n");
                continue;
            }

            if (temp > 30 || air == "POOR") {
                cout << "---ALLARME RILEVATO---" << endl;
                allarm = true;
            }

            sleep(3);
        }
    }

}

int main(int argc, char* argv[]) {

    if (argc != 3) {
        cout << "usage: " << argv[0] << " <id> <central port>\n";
        return -1;
    }

    string id = argv[1];
    int central_port = stoi(argv[2]);

    int sockfd = socket(AF_INET, SOCK_STREAM, 0);
    if (sockfd < 0) {
        perror("Errore nella socket\n");
        return -1;
    }

    struct sockaddr_in central_addr;
    socklen_t len = sizeof(central_addr);

    central_addr.sin_port = htons(central_port);
    central_addr.sin_family = AF_INET;
    inet_pton(AF_INET, "127.0.0.1", &central_addr.sin_addr);

    if (connect(sockfd, (struct sockaddr*)&central_addr, len) < 0) {
        perror("Errore nella connessione\n");
        return -1;
    }
    cout << "Sensore " << id << " connesso\n";

    thread t1(protocol, sockfd, id);
    thread t2(rcvMsg, sockfd);

    t1.join();
    t2.detach();

    close(sockfd);
    return 0;

}